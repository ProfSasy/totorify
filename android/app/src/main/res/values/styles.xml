<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- What the window shows while the app starts, until Flutter draws its
         first frame: the logo on black, as the app itself is. A light theme
         here is a white screen for the seconds a phone takes to start. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- What is behind the Flutter view once the app runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
